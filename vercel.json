{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/|shared/|@vite/|@react-refresh|node_modules/|@id/|@fs/|fonts/|images/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
