{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/types/app"
  },
  "include": [
    "api",
    "server",
    "shared",
    "src",
    "node_modules/vite/client.d.ts",
    "src/vite.env.d.ts"
  ]
}
