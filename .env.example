# Use the connection string for the Neon dev branch locally.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: connection string for the Neon master branch. Targeted by
# `pnpm db:migrate:master` and `pnpm db:set-role:master` when replaying
# migrations on the production branch before a release.
NEON_DATABASE_URL_MASTER=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Neon Auth (Managed Better Auth) base URL for the SPA.
# Copy it from the Neon Console: Settings > Better Auth > Project Info.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# The same URL, used by the API functions to verify session JWTs.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# Under `pnpm dev:vercel`, any variable also configured in the linked Vercel
# project's Development environment overrides this file (Vite gives process
# env priority over .env files). Keep local-only values out of the cloud
# Development scope so this file stays the source of truth locally.

# Neon Object Storage (S3-compatible) for public uploads (avatars). Copy the
# four values from the Neon Console: Connect > Storage tab > Parameters only
# (AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
# map to the NEON_STORAGE_* names below). Buckets are not configured here:
# register them in server/core/storage.ts (PUBLIC_BUCKETS) and create them
# in the Neon Console with access level public_read. Without these
# variables, profile setup still works; users just cannot upload photos.
NEON_STORAGE_ENDPOINT=https://<branch-id>.storage.c-<n>.<region>.aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Server-only AI Chat configuration. Never prefix these names with VITE_.
# Add these to .env.local for pnpm dev:vercel, or to Vercel environment settings.
# The function appends /chat/completions to AI_BASE_URL.
AI_API_KEY=
AI_BASE_URL=https://example.com/v1
AI_MODEL=example-model
