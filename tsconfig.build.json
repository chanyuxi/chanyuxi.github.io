{
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.build.tsbuildinfo",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/types/build"
  },
  "include": [
    "drizzle.config.ts",
    "vite.config.ts",
    "eslint.config.ts",
    "commitlint.config.ts",
    "build/**/*.ts",
    "scripts/**/*.ts",
    "shared/markdown/**/*.ts"
  ]
}
